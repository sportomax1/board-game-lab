{
  "manifest_version": 3,
  "name": "BGG Community Wiki Bridge",
  "version": "1.0.0",
  "description": "Read BGG Community Wiki pages from your own browser session into Board Game Lab. No cookies or credentials are transmitted.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://boardgamegeek.com/*",
    "https://www.boardgamegeek.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://board-game-lab-one-phi-42.vercel.app/*",
        "https://vercel-one-phi-42.vercel.app/*",
        "https://board-game-lab-kevins-projects-3ccf05a5.vercel.app/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boardgamegeek.com/*",
        "https://www.boardgamegeek.com/*"
      ],
      "js": [
        "bgg-reader.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
