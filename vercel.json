{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/credits",
      "destination": "/credits.html"
    },
    {
      "source": "/bgg-contacts",
      "destination": "/bgg-contacts-login.html"
    }
  ],
  "crons": [
    {
      "path": "/api/rankstore-sync",
      "schedule": "0 1 * * *"
    }
  ]
}
