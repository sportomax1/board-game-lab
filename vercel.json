{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/bgg-lab",
      "destination": "/api/core/bgg-lab"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/bgg-max-scan",
      "destination": "/api/core?route=bgg-max-scan"
    },
    {
      "source": "/api/bgg-prices",
      "destination": "/api/core?route=bgg-prices"
    },
    {
      "source": "/api/cardboard-proxy",
      "destination": "/api/core?route=cardboard-proxy"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/api/core?route=image-proxy"
    },
    {
      "source": "/api/log-ranks",
      "destination": "/api/core?route=log-ranks"
    },
    {
      "source": "/api/firebase-config",
      "destination": "/api/core?route=firebase-config"
    },
    {
      "source": "/api/get-password",
      "destination": "/api/core?route=get-password"
    },
    {
      "source": "/api/supabase-config",
      "destination": "/api/core?route=supabase-config"
    },
    {
      "source": "/api/bga-data",
      "destination": "/api/bga?route=data"
    },
    {
      "source": "/api/bga-game-catalog",
      "destination": "/api/bga?route=game-catalog"
    },
    {
      "source": "/api/bga-plays",
      "destination": "/api/bga?route=plays"
    },
    {
      "source": "/api/bga-studio-data",
      "destination": "/api/bga?route=studio-data"
    },
    {
      "source": "/api/bga-studio-export",
      "destination": "/api/bga?route=studio-export"
    },
    {
      "source": "/bga-studio.csv",
      "destination": "/api/bga?route=studio-export"
    },
    {
      "source": "/credits",
      "destination": "/credits.html"
    },
    {
      "source": "/bgg-contacts",
      "destination": "/bgg-contacts.html"
    }
  ],
  "crons": [
    {
      "path": "/api/rankstore-sync",
      "schedule": "0 1 * * *"
    }
  ]
}
